</div>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <title> Create Product</title>
</head>

<body>
  
    <%- include("partials/navbar") %>
    <section class="hero">
      <h1>Premium Bags Collection</h1>
      <p> Discover mordern bags Crafted for everyday use</p>

    </section>
    <div class="products">
      <% products.forEach(product=>{%>
        <div class="card" style="background:<%=product.bgcolor%>;  color:<%= product.textcolor %>;">
          <h2>
            <%=product.name%>
          </h2>
          <p>
            <%=product.price%>
          </p>
          <img src="/images/<%= product.image %>" width="150">
          <a href="/products/addtocart/<%= product._id%>" class="add-cart-btn">
            Add To Cart
          </a>
        </div>
        <%})%>
</body>

</html>