
        <!DOCTYPE html>
        <html lang="en">

        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <link rel="stylesheet" href="/stylesheets/style.css">
            <title> Create Product</title>
        </head>

        <body>
                <h1>Your Cart</h1>
                <% user.cart.forEach(product=>{%>
                    <div class="cart-card">
                        <h2>
                            <%=product.name%>
                        </h2>
                        <p>
                            <%=product.price%>
                        </p>
                        <a href="/products/remove/<%= product._id %>">
                            Remove
                        </a>
                    </div>
                    <%})%>
                        <h2>Total: ₹<%= total %>
                        </h2>
         
        </body>

        </html>